# Transactional outbox over RabbitMQ — config/tools/outbox/amqp
RABBIT_DSN=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=events
DB_DRIVER=pgx
DB_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RELAY_NAME=
OUTBOX_POLL_INTERVAL=5s
OUTBOX_STALE_AFTER=1m
OUTBOX_RETENTION=168h
OUTBOX_PURGE_INTERVAL=1h
